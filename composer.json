{
    "name": "netlogix/symfony-tolgee-translation-provider",
    "description": "Symfony Tolgee Translation Provider Bridge",
    "license": "MIT",
    "type": "symfony-bridge",
    "version": "2.0.0",
    "keywords": [
        "tolgee",
        "translation",
        "provider"
    ],
    "authors": [
        {
            "name": "Sascha Heilmeier",
            "email": "sascha.heilmeier@netlogix.de"
        }
    ],
    "homepage": "https://github.com/netlogix/symfony-tolgee-translation-provider",
    "support": {
        "issues": "https://github.com/netlogix/symfony-tolgee-translation-provider/issues",
        "source": "https://github.com/netlogix/symfony-tolgee-translation-provider/",
        "docs": "https://github.com/netlogix/symfony-tolgee-translation-provider/blob/main/README.md"
    },
    "require": {
        "php": "^7.4 || ^8.0",
        "symfony/config": "^5.4 || ^6.4 || ^7.0",
        "symfony/http-client": "^5.4 || ^6.4 || ^7.0",
        "symfony/intl": "^5.4 || ^6.4 || ^7.0",
        "symfony/mime": "^5.4 || ^6.4 || ^7.0",
        "symfony/polyfill-intl-icu": "^1.28",
        "symfony/translation": "^5.4 || ^6.4 || ^7.0"
    },
    "require-dev": {
        "carthage-software/mago": "*",
        "ergebnis/composer-normalize": "*",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^9.6",
        "rector/rector": "*",
        "symfony/console": "^5.4 || ^6.4 || ^7.0",
        "symfony/framework-bundle": "^5.4 || ^6.4 || ^7.0",
        "symfony/phpunit-bridge": "^5.4 || ^6.4 || ^7.0"
    },
    "autoload": {
        "psr-4": {
            "Netlogix\\SymfonyTolgeeTranslationProvider\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Netlogix\\SymfonyTolgeeTranslationProvider\\Test\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "carthage-software/mago": true,
            "ergebnis/composer-normalize": true
        }
    },
    "scripts": {
        "apply-coding-standard": [
            "@composer:normalize:fix",
            "@rector:fix",
            "@lint:fix",
            "@format:fix"
        ],
        "coding-standard": [
            "@composer:normalize",
            "@rector",
            "@lint",
            "@format"
        ],
        "composer:normalize": "@composer normalize --no-check-lock --dry-run",
        "composer:normalize:fix": "@composer normalize --no-check-lock",
        "format": "mago fmt --dry-run",
        "format:fix": "mago fmt",
        "lint": "mago lint",
        "lint:fix": "mago lint --fix",
        "lint:unsafe": "mago lint --unsafe --dry-run",
        "lint:unsafe:fix": "mago lint --fix --unsafe",
        "rector": "rector process --dry-run",
        "rector:fix": "rector process",
        "test": "phpunit",
        "test-coverage": "XDEBUG_MODE=coverage phpunit --coverage-html=coverage"
    }
}
